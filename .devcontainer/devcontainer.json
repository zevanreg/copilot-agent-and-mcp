{
  "name": "Book Favorites App",
  "image": "mcr.microsoft.com/devcontainers/javascript-node",
  "forwardPorts": [4000, 5173],
  "portsAttributes": {
    "4000": {
      "label": "Backend API",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Frontend App",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  },
  "remoteUser": "node"
}
